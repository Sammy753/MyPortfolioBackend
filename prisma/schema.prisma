generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatIDo {
  id          String   @id @default(uuid())
  title       String
  icon        String // describe-icon url (Cloudinary)
  thumbnail   String // image url (Cloudinary)
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id                     String   @id @default(uuid())
  title                  String
  overview               String
  category               String // e.g. "e-commerce", "portfolio", "saas", "other"
  aim                    String
  objective              String
  technologyUsed         String[]
  developmentProcess     String? // frontend work
  designProcess          String? // design work
  challengesAndSolutions String?
  limitations            String?
  outcome                String?
  mobileVideoUrl         String // 1st - mobile
  tabVideoUrl            String // 2nd - tab
  laptopVideoUrl         String // 3rd - laptop
  desktopVideoUrl        String // 4th - desktop
  isTeamWork             Boolean  @default(false)
  myRole                 String? // required when isTeamWork = true (enforced in DTO)
  keyFeatures            String[]
  liveLink               String?
  repoLink               String?
  description            String
  published              Boolean  @default(false) // draft by default; publish explicitly to notify subscribers
  publishedAt            DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model SkillTool {
  id          String   @id @default(uuid())
  icon        String
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
